# Trequila environment variables.
#
# Local development with Docker: run `make env` instead of copying this file. It
# writes .env with generated secrets, and docker-compose.yml supplies the service
# URLs. This file documents every variable for running the binary directly or in
# production.

# ===== Server =====
PORT=8080

# ===== External Services (REQUIRED) =====
# NATS server with JetStream enabled (nats://localhost:4222 for a local `nats -js`,
# or a hosted provider such as Synadia NGS: https://synadia.com/ngs)
NATS_URL=nats://localhost:4222

# NATS Credentials File - Path to your .creds file from Synadia NGS
# NATS_CREDS_FILE=./trequila.creds

# PostgreSQL - For Heroku, this is auto-set. For local, use your own.
DATABASE_URL=postgres://postgres:password@localhost:5432/trequila?sslmode=disable

# Redis - For Heroku, this is auto-set. For local, use your own.
REDIS_URL=localhost:6379

# Only needed for rediss:// endpoints whose certificate is issued for a hostname
# other than the one in REDIS_URL (Heroku Data for Redis does this: the URL points
# at the EC2 host, the certificate names the *.service.shogun.heroku.com alias).
# Without it the TLS handshake fails and the cache silently degrades to no cache.
# REDIS_TLS_SERVER_NAME=

# The certificate authority to verify the Redis server against, as a PEM bundle
# (optionally base64-encoded so it fits on one line). This is the fix for a
# provider that signs with its own authority — Heroku Data for Redis uses
# OU=Data Self Sign Authority, which no system trust store carries, so without it
# the chain cannot verify and the cache silently degrades to no cache at all.
#
# Verification stays fully on: the certificate must chain to this root AND match
# REDIS_TLS_SERVER_NAME. The value is not a secret; the server presents these
# certificates to anyone who connects. Capture the root with:
#
#   openssl s_client -connect <host>:<port> -servername <cert-hostname> -showcerts \
#     </dev/null 2>/dev/null \
#     | awk '/BEGIN CERTIFICATE/,/END CERTIFICATE/' | awk '/BEGIN/{n++} n==3'
#
# REDIS_TLS_CA_CERT=

# Last resort, and only if pinning the authority above is somehow impossible.
# Turns OFF certificate verification: the connection stays encrypted, but the
# server is no longer authenticated, so an attacker able to intercept traffic
# between the app and Redis would not be detected. Never set this just to make an
# unexplained TLS error go away.
# REDIS_TLS_INSECURE_SKIP_VERIFY=true

# ===== Security (REQUIRED) =====
# JWT Secret (REQUIRED - server fails to start if unset or < 32 bytes)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production-must-be-at-least-32-bytes

# Encryption Key (REQUIRED - 32-byte base64 string for AES-256-GCM)
# Generate with: openssl rand -base64 32
# Warning: Losing this key means all stored user API keys become unreadable.
ENCRYPTION_KEY=

# ===== Frontend / CORS =====
# Comma-separated list of browser origins allowed to call the API.
# Defaults to https://trequila.namankhandelwal.dev when unset.
CORS_ALLOWED_ORIGINS=https://trequila.namankhandelwal.dev
# Base URL the Google OAuth callback redirects back to (no trailing slash).
FRONTEND_URL=https://trequila.namankhandelwal.dev

# ===== Logging and metrics =====
# LOG_LEVEL=info                 # debug | info | warn | error
# LOG_FORMAT=json                # json | text (default: text on a terminal, JSON otherwise)
# Prometheus metrics are served at /metrics only when this is set, behind this bearer token.
# METRICS_TOKEN=

# ===== Provider URLs =====
# By default an OpenAI-compatible key's base_url must be public https, so users cannot aim the
# server at internal services. Set this only if you run a model on your own network.
# ALLOW_PRIVATE_PROVIDER_URLS=false

# ===== Google OAuth (Optional - for social login) =====
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ===== Optional Overrides =====
# HTTP_USER_AGENT=Trequila/1.0 (https://github.com/sky-walkerx/trequila)
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# WIKIPEDIA_API_URL=https://en.wikipedia.org/api/rest_v1
# OPENVERSE_API_URL=https://api.openverse.engineering/v1
