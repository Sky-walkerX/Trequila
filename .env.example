# Trequila Environment Variables
# Copy this file to .env and fill in your values

# ===== Server =====
PORT=8080

# ===== External Services (REQUIRED) =====
# NATS JetStream URL - Use Synadia NGS (https://synadia.com/ngs)
NATS_URL=tls://connect.ngs.global

# NATS Credentials File - Path to your .creds file from Synadia NGS
NATS_CREDS_FILE=./trequila.creds

# PostgreSQL - For Heroku, this is auto-set. For local, use your own.
DATABASE_URL=postgres://postgres:password@localhost:5432/trequila?sslmode=disable

# Redis - For Heroku, this is auto-set. For local, use your own.
REDIS_URL=localhost:6379

# ===== Security =====
# JWT Secret (REQUIRED - use a strong random string in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# ===== Google OAuth (Optional - for social login) =====
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ===== External API Keys (REQUIRED) =====
# Google Gemini API Key (for AI itinerary generation)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Pexels API Key (for destination images)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# Geoapify API Key (for places/geocoding)
# Get your key at: https://www.geoapify.com/
GEOAPIFY_API_KEY=your-geoapify-api-key
